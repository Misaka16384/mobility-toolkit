# ---- Runtime artifacts ----
# Everything under output/ is generated by solver runs (logs, scratch M2
# scripts, discovery JSON) and recreated on demand by setup_output_dirs().
output/
# Local exploratory and research artifact trees used by toolkit experiments:
# PDFs, tables, generated scripts, and logs should stay local only.
tmp/
# Workspace scratch output for intermediate scans/reports and ad-hoc outputs.
working/
*.m2
m2_script_*_dump.m2

# Generated/seeded SQLite cache — reproducible via `db init` / `db sync`.
# Tracked seed data lives in registry.py; uncomment to ship a prebuilt DB.
mobility_models.db

# ---- Per-platform install targets (written by `install`, not source) ----
